load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//bazel:ocs2_cxx_flags.bzl", "OCS2_COPTS", "OCS2_LINKOPTS")

package(default_visibility = ["//visibility:public"])

# NOTE: every ament_add_gtest/catkin_add_gtest call in the original
# CMakeLists.txt for this package is commented out -- there is no active
# test target to mirror here.
cc_library(
    name = "ocs2_ddp",
    srcs = [
        "src/ContinuousTimeLqr.cpp",
        "src/DDP_HelperFunctions.cpp",
        "src/DDP_Settings.cpp",
        "src/GaussNewtonDDP.cpp",
        "src/HessianCorrection.cpp",
        "src/ILQR.cpp",
        "src/SLQ.cpp",
        "src/riccati_equations/ContinuousTimeRiccatiEquations.cpp",
        "src/riccati_equations/DiscreteTimeRiccatiEquations.cpp",
        "src/riccati_equations/RiccatiModification.cpp",
        "src/search_strategy/LevenbergMarquardtStrategy.cpp",
        "src/search_strategy/LineSearchStrategy.cpp",
        "src/search_strategy/StrategySettings.cpp",
    ],
    hdrs = glob(["include/**/*.h"]),
    copts = OCS2_COPTS,
    includes = ["include"],
    linkopts = OCS2_LINKOPTS,
    deps = [
        "//ocs2_core",
        "//ocs2_mpc",
        "//ocs2_oc",
        "//ocs2_test_tools/ocs2_qp_solver",
        "@boost.property_tree",
    ],
)

cc_binary(
    name = "ocs2_ddp_lintTarget",
    srcs = ["src/lintTarget.cpp"],
    copts = OCS2_COPTS,
    includes = ["include"],
    linkopts = OCS2_LINKOPTS,
    deps = [":ocs2_ddp"],
)
