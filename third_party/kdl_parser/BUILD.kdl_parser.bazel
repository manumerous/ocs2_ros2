"""BUILD overlay for @kdl_parser (http_archive, real upstream 3.0.1-3).

RCR's own `kdl_parser` module registers only an ament-bookkeeping stub
(same situation as `pinocchio`); this fetches the real
ros2-gbp/kdl_parser-release source directly instead (the exact same
release tarball RCR's own stub module points at, just with a real
BUILD.bazel this time). `visibility_control.hpp` is fully
self-computing (no configure_file step at all), so no generated-header
patch is needed here, unlike pinocchio.
"""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "kdl_parser",
    srcs = ["src/kdl_parser.cpp"],
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include"],
    deps = [
        "@orocos_kdl",
        "@rcutils//:rcutils_library",
        "@urdf//:urdf_library",
    ],
)
