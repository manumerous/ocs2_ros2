# Exported test-support header used by ocs2_core's own tests *and*
# downstream packages (ocs2_test_tools/ocs2_qp_solver's test), matching
# `install(DIRECTORY test/include/ DESTINATION include)` in the original
# CMakeLists.txt, which publishes this alongside the main include/ dir.
cc_library(
    name = "test_tools",
    testonly = True,
    hdrs = ["test/include/ocs2_core/test/testTools.h"],
    includes = ["test/include"],
    deps = [":ocs2_core"],
)

