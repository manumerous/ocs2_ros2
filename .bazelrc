# Bazel registries: Bazel Central Registry for generic C++ deps, and the
# ROS Central Registry (RCR) for ROS2 "Lyrical Luth" packages.
# The RCR registry is listed first so its modules take precedence when a
# name exists in both (e.g. RCR's newer `pinocchio` vs BCR's stale one).
common --registry=https://intrinsic-opensource.github.io/ros-central-registry
common --registry=https://bcr.bazel.build

# Test hermeticity, per RCR's own guidance for ROS2 interface/codegen tests.
test --sandbox_default_allow_network=false

# Disable Bazel's automatic intermediate .so generation for cc_library deps
# shared by multiple binaries/tests ("dynamic_mode=default"). With it on,
# Bazel builds e.g. ocs2_core as its own standalone .so, which must resolve
# all of its symbols (including Boost.Log's) at *that* .so's link time --
# and that broke with real "undefined reference to boost::log::..." errors
# once the dependency graph got deep enough (ocs2_core -> boost.log).
# Fully static internal linking matches what the original CMake build
# actually produced anyway.
build --dynamic_mode=off

# @rosdistro's own `rmw` build setting defaults to "dynamic", which pulls
# in *every* RMW middleware backend rclcpp can be built against --
# including rmw_zenoh_cpp, which drags in a Rust toolchain (via zenoh-c's
# Cargo build script) just to compile a plain C++ node. OCS2 doesn't need
# runtime RMW switching; pin to the same default a plain ROS2 install
# uses (rmw_fastrtps_cpp) instead of standing up a whole second
# language's toolchain for a backend nothing here uses.
build --@rosdistro//:rmw=rmw_fastrtps_cpp

# The existing CMake build pins C++14 (see ocs2_core/cmake/ocs2_cxx_flags.cmake).
# Preserve that for OCS2's own targets -- but deliberately NOT as a global
# --cxxopt here, since that would also force every external dependency
# (including googletest, which the RCR/BCR-resolved graph only offers as
# >=1.17.0.bcr.2 and which hard #errors below C++17: "C++ versions less
# than C++17 are not supported.") down to C++14 too. Instead, "-std=c++14"
# is added directly to OCS2_COPTS (bazel/ocs2_cxx_flags.bzl) on OCS2's own
# cc_library/cc_binary targets only, and "-std=c++17" to OCS2_TEST_COPTS
# for cc_test targets that pull in gtest. Everything else (external deps)
# is left on the toolchain's own ambient default, which happens to already
# be gnu++17 on the GCC 13 this was verified against -- if building on a
# GCC/Clang whose *default* is older than C++17, googletest would need an
# explicit --cxxopt=-std=c++17 added back here.
