load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//bazel:ocs2_cxx_flags.bzl", "OCS2_COPTS", "OCS2_LINKOPTS", "OCS2_TEST_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "ocs2_sqp",
    srcs = [
        "src/SqpLogging.cpp",
        "src/SqpSettings.cpp",
        "src/SqpSolver.cpp",
    ],
    hdrs = glob(["include/**/*.h"]),
    copts = OCS2_COPTS,
    includes = ["include"],
    linkopts = OCS2_LINKOPTS,
    deps = [
        "//ocs2_core",
        "//ocs2_mpc",
        "//ocs2_oc",
        "//ocs2_sqp/hpipm_catkin",
        "//ocs2_test_tools/ocs2_qp_solver",
        "@boost.filesystem",
        "@boost.log",
        "@boost.system",
    ],
)

cc_test(
    name = "test_ocs2_sqp",
    srcs = [
        "test/testCircularKinematics.cpp",
        "test/testSwitchedProblem.cpp",
        "test/testUnconstrained.cpp",
        "test/testValuefunction.cpp",
    ],
    copts = OCS2_TEST_COPTS,
    deps = [
        ":ocs2_sqp",
        "//ocs2_core",
        "//ocs2_oc:test_tools",
        "@googletest//:gtest_main",
    ],
)
